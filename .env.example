# Скопируйте в .env или запустите ./setup.sh — он сгенерирует секреты сам.

# Домен (для Let's Encrypt) или публичный IP VPS (для самоподписанного сертификата)
PUBLIC_HOST=iot.example.com
# letsencrypt | selfsigned
TLS_MODE=letsencrypt
LE_EMAIL=you@example.com

# Секреты (только буквы и цифры, 32+ символа)
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me
MQTT_BACKEND_PASSWORD=change_me
MQTT_INGEST_PASSWORD=change_me
MQTT_SCENARIOS_PASSWORD=change_me
EMQX_COOKIE=change_me
EMQX_DASHBOARD_PASSWORD=change_me
# Ключ REST API EMQX для бэкенда: разрыв MQTT-сессий при отзыве доступа
EMQX_API_KEY=iot-backend
EMQX_API_SECRET=change_me

# Регистрацию можно выключить (false) после создания своего аккаунта
ALLOW_REGISTRATION=true
MAX_DEVICES_PER_USER=50
MAX_BRIDGE_DEVICES=300
# Время жизни JWT, секунды (7 дней)
JWT_TTL_SEC=604800
MQTT_PUBLIC_PORT=8883

# ---------- уведомления ----------
# Платформенный Telegram-бот (создайте у @BotFather). Пусто — пользователи подключают своих ботов сами.
TELEGRAM_BOT_TOKEN=
# Свой адрес Bot API (зеркало или локальный telegram-bot-api), если api.telegram.org недоступен
TELEGRAM_API_URL=https://api.telegram.org

# Максимальный размер файла прошивки для OTA, МБ (не больше 16 — лимит nginx)
FIRMWARE_MAX_MB=4

# Ресурсы VPS (для автотюнинга PostgreSQL)
PG_TUNE_MEMORY=1GB
PG_TUNE_CPUS=2

# Часовой пояс: логи, бэкапы и расписания сценариев по умолчанию
TZ=Asia/Yekaterinburg

# ---------- бэкапы ----------
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=7
# S3-совместимое хранилище (необязательно): Timeweb, Yandex Object Storage, Selectel, AWS...
S3_BUCKET=
S3_PREFIX=iot-backups
S3_ENDPOINT=
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KEEP_DAYS=30

# ---------- мосты (выдаются в панели: раздел «Мосты») ----------
# docker compose --profile zigbee up -d
ZIGBEE_BRIDGE_ID=
ZIGBEE_BRIDGE_TOKEN=
ZIGBEE_MQTT_URL=mqtt://host.docker.internal:1883
ZIGBEE_MQTT_USERNAME=
ZIGBEE_MQTT_PASSWORD=
# docker compose --profile esphome up -d
ESPHOME_BRIDGE_ID=
ESPHOME_BRIDGE_TOKEN=
ESPHOME_MQTT_URL=mqtt://host.docker.internal:1883
ESPHOME_MQTT_USERNAME=
ESPHOME_MQTT_PASSWORD=
# docker compose --profile generic up -d
GENERIC_BRIDGE_ID=
GENERIC_BRIDGE_TOKEN=
GENERIC_MQTT_URL=mqtt://host.docker.internal:1883
GENERIC_MQTT_USERNAME=
GENERIC_MQTT_PASSWORD=
