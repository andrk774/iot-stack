PUBLIC_HOST=iot.example.com
TZ=Asia/Yekaterinburg
ZIGBEE_ADAPTER=/dev/ttyUSB0
ZIGBEE_BRIDGE_ID=
ZIGBEE_BRIDGE_TOKEN=
ESPHOME_BRIDGE_ID=
ESPHOME_BRIDGE_TOKEN=
# Tasmota: docker compose --profile tasmota up -d (в Tasmota: MQTT Host = адрес этого компьютера)
TASMOTA_BRIDGE_ID=
TASMOTA_BRIDGE_TOKEN=
# Shelly: docker compose --profile shelly up -d (в Shelly: MQTT включён, для Gen2 — «Generic status update over MQTT»)
SHELLY_BRIDGE_ID=
SHELLY_BRIDGE_TOKEN=
